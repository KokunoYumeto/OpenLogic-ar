{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/notation-registry-v1.1.json",
  "title": "Interlanguage semantic notation entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notation_id",
    "authority_class",
    "source_binding",
    "kind",
    "logical_operands",
    "source_tex",
    "direction_semantics",
    "codepoint_rewrite_policy",
    "glyph_mirror_policy",
    "localized_text_slots",
    "status"
  ],
  "properties": {
    "notation_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "authority_class": {"enum": ["upstream-source", "local-build-control", "standard"]},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "artifact", "sha256", "span"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]},
        "artifact": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "span": {"type": "string", "minLength": 1}
      }
    },
    "kind": {
      "enum": [
        "binary_relation",
        "binary_operator",
        "unary_operator",
        "binder",
        "delimiter",
        "tuple_constructor",
        "arrow",
        "counter",
        "identifier",
        "other"
      ]
    },
    "logical_operands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source_tex": {"type": "string", "minLength": 1},
    "unicode": {
      "type": "array",
      "items": {"type": "string", "pattern": "^U\\+[0-9A-F]{4,6}$"},
      "uniqueItems": true
    },
    "direction_semantics": {
      "enum": ["ordered_operands", "absolute_geometry", "profile_layout", "single_ltr_run", "none"]
    },
    "codepoint_rewrite_policy": {"enum": ["never", "explicit-profile-only", "not-applicable"]},
    "glyph_mirror_policy": {"enum": ["unicode-bidi", "profile-renderer", "never", "not-applicable"]},
    "arrow_policy": {"type": ["string", "null"]},
    "localized_text_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "semantic_role"],
        "properties": {
          "slot": {"type": "string", "minLength": 1},
          "semantic_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {"enum": ["accepted", "candidate", "adverse-test", "deprecated"]},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["binary_relation", "binary_operator", "arrow"]}}},
      "then": {"properties": {"logical_operands": {"minItems": 2, "maxItems": 2}}}
    },
    {
      "if": {"properties": {"kind": {"const": "unary_operator"}}},
      "then": {"properties": {"logical_operands": {"minItems": 1, "maxItems": 1}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["binder", "delimiter", "tuple_constructor", "counter"]}}},
      "then": {"properties": {"logical_operands": {"minItems": 1}}}
    }
  ]
}
