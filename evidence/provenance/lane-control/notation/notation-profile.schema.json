{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlanguage.local/schemas/notation-profile-v1.1.json",
  "title": "Interlanguage locale notation profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "locale",
    "language_evidence_pool",
    "prose_direction",
    "surfaces",
    "orthography",
    "inheritance",
    "qa",
    "review"
  ],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "minLength": 2},
    "language_evidence_pool": {"type": "string", "minLength": 1},
    "prose_direction": {"enum": ["ltr", "rtl"]},
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prose", "inline_math", "display_math", "counter", "diagram", "search", "speech"],
      "properties": {
        "prose": {"$ref": "#/$defs/surface"},
        "inline_math": {"$ref": "#/$defs/surface"},
        "display_math": {"$ref": "#/$defs/surface"},
        "counter": {"$ref": "#/$defs/surface"},
        "diagram": {"$ref": "#/$defs/surface"},
        "search": {"$ref": "#/$defs/surface"},
        "speech": {"$ref": "#/$defs/surface"}
      }
    },
    "orthography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalization", "required", "forbidden", "join_controls"],
      "properties": {
        "normalization": {"enum": ["NFC"]},
        "required": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "join_controls": {"type": "string", "minLength": 1}
      }
    },
    "regional_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "digits", "math_direction"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["evidence-slot", "candidate", "accepted", "deprecated"]},
          "digits": {"type": "string", "minLength": 1},
          "math_direction": {"type": "string", "minLength": 1},
          "activation": {"type": "string", "minLength": 1}
        }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "qa": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_replay", "human_native"],
      "properties": {
        "ai_replay": {"type": "string", "minLength": 1},
        "human_native": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "numbering_system", "isolation"],
      "properties": {
        "direction": {"enum": ["ltr", "rtl", "source", "semantic"]},
        "numbering_system": {"enum": ["latn", "arab", "arabext", "source", "not-applicable"]},
        "isolation": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
